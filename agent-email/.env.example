# Kopiere diese Datei zu ".env" und trage dort deine echten Werte ein.
# Die ".env" selbst wird nie eingecheckt (siehe .gitignore).

# Host deines IMAP-Anbieters, z. B. imap.deinanbieter.de
IMAP_HOST=imap.deinanbieter.de

# Standard-Port für IMAP über SSL ist 993
IMAP_PORT=993

# Deine volle E-Mail-Adresse
IMAP_USER=deine-adresse@beispiel.de

# App-Passwort oder normales Passwort, je nach Anbieter.
# Falls dein Anbieter OAuth2 verlangt, sag Bescheid - das braucht eine andere Anbindung.
IMAP_PASSWORD=dein-app-passwort

# In der Regel true lassen, außer dein Anbieter verlangt unverschlüsselte Verbindungen
IMAP_USE_SSL=true

# Ordner, der auf neue Mails überwacht wird
IMAP_FOLDER=INBOX

# API-Key für die Klassifizierung über die Claude API.
# Zu finden/erstellen unter https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=dein-anthropic-api-key

# Optional, Standard ist ein schnelles/günstiges Modell (ausreichend für die
# Klassifizierung anhand der festen Kategorienliste)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Wohin Anhänge klassifizierter Mails abgelegt werden: google_drive oder onedrive
STORAGE_PROVIDER=google_drive

# Nur nötig, wenn STORAGE_PROVIDER=onedrive.
# Client-ID deiner Azure-AD-App-Registrierung (siehe README, kein Secret nötig)
ONEDRIVE_CLIENT_ID=deine-azure-app-client-id

# Optional, Standard "common" (persönliche + geschäftliche Microsoft-Konten).
# "consumers" für ausschließlich private Microsoft-Konten (z.B. outlook.com)
ONEDRIVE_TENANT=common
