# Kopiere diese Datei zu ".env" und trage dort deine echten Werte ein.
# Die ".env" selbst wird nie eingecheckt (siehe .gitignore).

# Host deines IMAP-Anbieters, z. B. imap.deinanbieter.de
IMAP_HOST=imap.deinanbieter.de

# Standard-Port für IMAP über SSL ist 993
IMAP_PORT=993

# Deine volle E-Mail-Adresse
IMAP_USER=deine-adresse@beispiel.de

# App-Passwort oder normales Passwort, je nach Anbieter.
# Falls dein Anbieter OAuth2 verlangt, sag Bescheid - das braucht eine andere Anbindung.
IMAP_PASSWORD=dein-app-passwort

# In der Regel true lassen, außer dein Anbieter verlangt unverschlüsselte Verbindungen
IMAP_USE_SSL=true

# Ordner, der auf neue Mails überwacht wird
IMAP_FOLDER=INBOX

# Wer die Klassifizierung übernimmt: anthropic (Claude API) oder local
# (eigenes Ollama-Modell, siehe unten). Standard: anthropic
CLASSIFIER_PROVIDER=anthropic

# Nur nötig, wenn CLASSIFIER_PROVIDER=anthropic.
# API-Key für die Klassifizierung über die Claude API.
# Zu finden/erstellen unter https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=dein-anthropic-api-key

# Optional, Standard ist ein schnelles/günstiges Modell (ausreichend für die
# Klassifizierung anhand der festen Kategorienliste)
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Nur nötig, wenn CLASSIFIER_PROVIDER=local.
# Adresse des Ollama-Servers. Im docker-compose-Setup ist das der
# Service-Name "ollama", lokal ohne Docker meist http://localhost:11434
OLLAMA_HOST=http://ollama:11434

# Nur nötig, wenn CLASSIFIER_PROVIDER=local.
# Name des per "ollama pull" heruntergeladenen Modells, z.B. qwen2.5:1.5b
OLLAMA_MODEL=qwen2.5:1.5b

# Wohin Anhänge klassifizierter Mails abgelegt werden: google_drive, onedrive
# oder local (eigener Dateisystempfad, z.B. eine NAS-Freigabe, siehe unten)
STORAGE_PROVIDER=google_drive

# Nur nötig, wenn STORAGE_PROVIDER=onedrive.
# Client-ID deiner Azure-AD-App-Registrierung (siehe README, kein Secret nötig)
ONEDRIVE_CLIENT_ID=deine-azure-app-client-id

# Optional, Standard "common" (persönliche + geschäftliche Microsoft-Konten).
# "consumers" für ausschließlich private Microsoft-Konten (z.B. outlook.com)
ONEDRIVE_TENANT=common

# Nur nötig, wenn STORAGE_PROVIDER=local.
# Basis-Pfad, unter dem "Email-Ablage/<Kategorie>/..." angelegt wird.
#
# WICHTIG im docker-compose-Setup: Das ist NICHT der echte NAS-Pfad (z.B.
# NICHT "/volume1/Daten"), sondern der Pfad INNERHALB DES CONTAINERS - also
# die RECHTE Seite des Volume-Mounts in docker-compose.yml
# ("/volume1/Daten:/data" -> hier gehört "/data" hin, nicht "/volume1/Daten").
# Trägst du hier versehentlich den echten NAS-Pfad ein, legt das Programm
# klaglos einen neuen, unsichtbaren Ordner innerhalb des Containers an statt
# den gemounteten NAS-Ordner zu nutzen - kein Fehler, aber die Dateien landen
# nie auf dem NAS und gehen beim nächsten Rebuild verloren.
LOCAL_STORAGE_PATH=/data
